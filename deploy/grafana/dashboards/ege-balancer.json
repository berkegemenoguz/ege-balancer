    {
      "type": "bargauge",
      "title": "Share of traffic, last 5 minutes",
      "description": "With round robin every backend takes a tenth. Least connections moves traffic off slower backends.",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "ege-balancer-prometheus"
