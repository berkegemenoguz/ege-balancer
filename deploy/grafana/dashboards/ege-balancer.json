          "expr": "sort_desc(sum by (name) (label_replace(increase(lb_requests_total{backend=~\"$backend\"}[5m]), \"name\", \"$1\", \"backend\", \"([^:]+).*\")) / scalar(sum(increase(lb_requests_total[5m]))))",
