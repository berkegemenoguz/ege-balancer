    {
      "type": "stat",
      "title": "Retries per request",
      "description": "Retries sent for every hundred requests. The retry budget keeps this under its share when a pool fails.",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "ege-balancer-prometheus"
