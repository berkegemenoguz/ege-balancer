        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ege-balancer-prometheus"
          },
          "expr": "(sum(rate(lb_retries_total[$window])) or vector(0)) / sum(rate(lb_requests_total[$window]))",
