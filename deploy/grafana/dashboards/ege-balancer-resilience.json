{
  "uid": "ege-balancer-resilience",
  "title": "Ege-Balancer — Resilience",
  "description": "What happens when things fail: refusals, 5xx, retries and the retry budget, health and reloads.",
  "tags": [
    "ege-balancer"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "graphTooltip": 1,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "editable": true,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "ege-balancer"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "title": "Ege-Balancer",
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Configuration reloaded",
        "datasource": {
          "type": "prometheus",
          "uid": "ege-balancer-prometheus"
        },
        "enable": true,
        "iconColor": "blue",
        "expr": "changes(lb_config_reloads_total{result=\"applied\"}[20s]) > 0",
        "step": "10s",
        "titleFormat": "configuration reloaded",
        "textFormat": "SIGHUP applied",
        "useValueForTime": false
      },
      {
        "name": "Reload rejected",
        "datasource": {
          "type": "prometheus",
          "uid": "ege-balancer-prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "changes(lb_config_reloads_total{result=\"rejected\"}[20s]) > 0",
        "step": "10s",
        "titleFormat": "reload rejected",
        "textFormat": "the file was invalid; the running configuration was kept",
        "useValueForTime": false
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "backend",
        "label": "Backend",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "ege-balancer-prometheus"
        },
        "definition": "label_values(lb_backend_healthy, backend)",
        "query": {
          "qryType": 1,
          "query": "label_values(lb_backend_healthy, backend)",
          "refId": "backend"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 7,
        "hide": 0,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ],
          "selected": true
        },
        "options": []
      },
      {
        "name": "window",
        "label": "Window",
        "type": "custom",
        "query": "1m,5m,15m",
        "current": {
          "text": "1m",
          "value": "1m",
          "selected": true
        },
        "options": [
          {
            "text": "1m",
            "value": "1m",
            "selected": true
          },
          {
            "text": "5m",
            "value": "5m",
            "selected": false
          },
          {
            "text": "15m",
            "value": "15m",
            "selected": false
          }
        ],
        "hide": 0,
        "multi": false,
        "includeAll": false,
        "description": "How far back each rate and average looks. Longer windows smooth out noise."
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Right now",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Refused by the balancer",
      "description": "Requests the balancer answered itself: rate limited, badly framed, too large, no backend, retry budget.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "ege-balancer-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ege-balancer-prometheus"
          },
          "expr": "sum(rate(lb_rejected_requests_total{reason!=\"no_healthy_backend\"}[$window])) or vector(0)",
          "legendFormat": "",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              }
            ]
          },
          "unit": "reqps",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true
      }
    },
